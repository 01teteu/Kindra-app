# PostgreSQL local: serviço db do docker-compose.yml (porta 5432).
# Substitua a senha abaixo pela credencial do volume local já inicializado.
# Não use credenciais reais neste arquivo nem reinicialize o volume para trocar a senha.
DATABASE_URL="postgresql://kindra:SENHA_LOCAL@localhost:5432/kindra_db?schema=public"

# Segredo exclusivo para assinatura dos JWTs. Em produção é obrigatório:
# gere com `openssl rand -base64 32` e copie somente a saída Base64 para o ambiente.
# Não reutilize AUTH_CODE_HMAC_SECRET ou COOKIE_SECRET. Fora de produção, quando
# ausente, uma chave efêmera por processo é usada; reiniciar invalida JWTs pendentes.
JWT_SECRET="replace_with_base64_output_of_openssl_rand_base64_32"

# Chave exclusiva para HMAC dos códigos curtos. Em produção é obrigatória:
# gere com `openssl rand -base64 32` e copie somente a saída Base64 para o ambiente.
# Não reutilize JWT_SECRET. Sem esta variável fora de produção, uma chave efêmera
# por processo é usada; reiniciar ou usar processos distintos invalida códigos pendentes.
AUTH_CODE_HMAC_SECRET="replace_with_base64_output_of_openssl_rand_base64_32"

# E-mail transacional: Brevo. Obrigatórios em produção, sem fallback para mock.
# O remetente/domínio devem estar autenticados no provedor. Nunca prefixe segredos com VITE_.
BREVO_API_KEY=
EMAIL_FROM="Kindra <no-reply@mail.kindrafit.com>"
# Origem pública do frontend usada nos links dos e-mails. Produção exige HTTPS.
# No servidor de desenvolvimento atual, a aplicação roda em http://localhost:3000.
APP_URL="http://localhost:3000"
# Origem exata do navegador para validar a consolidação nutricional.
# Em produção, use a mesma origem pública HTTPS de APP_URL.
FRONTEND_URL="http://localhost:3000"

# Segredo independente de JWT_SECRET/HMAC. Configure valor aleatório no runtime.
COOKIE_SECRET=

# Mock apenas fora de produção. Opt-in local para exibir códigos/links ao testar manualmente.
# Nunca habilite em produção.
# EMAIL_MOCK_DEBUG=1

# Opcional. Sem esta variável, o Fastify não confia em X-Forwarded-*.
# Com reverse proxy, informe SOMENTE os IPs/CIDRs reais dos proxies confiáveis,
# separados por vírgula (exemplo de formato: 192.0.2.10,2001:db8::10/128).
# Não exponha a porta do Fastify diretamente à internet quando houver proxy.
# O proxy deve sobrescrever/normalizar X-Forwarded-For, X-Forwarded-Proto e
# X-Forwarded-Host. Nunca use trustProxy=true ou endereços de clientes aqui.
# Exemplo de sintaxe apenas; substitua pelo endereço real quando houver proxy:
# TRUSTED_PROXIES="192.0.2.10"

# Google OAuth: ambos devem usar o mesmo OAuth Web Client ID.
# Client ID não é Client Secret. GOOGLE_CLIENT_ID é obrigatório em produção.
# Nunca use um placeholder como configuração real de produção.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
