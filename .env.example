# PostgreSQL local: serviço db do docker-compose.yml (porta 5432).
# Substitua a senha abaixo pela credencial do volume local já inicializado.
# Não use credenciais reais neste arquivo nem reinicialize o volume para trocar a senha.
DATABASE_URL="postgresql://kindra:SENHA_LOCAL@localhost:5432/kindra_db?schema=public"

# Secret string para encriptação dos cookies JWT (Crie uma string longa e aleatória)
JWT_SECRET=change_me

# Configurações para envio de E-mail (Recomendado: Resend)
RESEND_API_KEY="re_..."
FRONTEND_URL="http://localhost:3000"

# Credenciais do Google OAuth (Para o login com Google)
# O Client ID deve ser gerado no Google Cloud Console (APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID="seu-client-id-aqui.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="seu-client-id-aqui.apps.googleusercontent.com"
