    "@fastify/static": "^10.1.3",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
